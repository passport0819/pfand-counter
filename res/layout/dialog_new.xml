<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dlg_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:text="@string/looking_up" />

        <TextView
            android:id="@+id/dlg_code"
            android:importantForAccessibility="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Shown once no name is found: the user's own name instead of "Unknown product". -->
        <EditText
            android:id="@+id/dlg_name_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dlg_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dlg_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- A known barcode two digits away: perhaps the camera misread this one. -->
        <TextView
            android:id="@+id/dlg_similar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/dlg_similar_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:text="@string/similar_use"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:text="@string/choose_deposit" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/dlg_help"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_accent"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:text="@string/g_open"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="15sp" />

            <Button
                android:id="@+id/dlg_ask_jev"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_accent"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:text="@string/jev_ask"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="15sp" />
        </LinearLayout>

        <!-- Why "Ask Jev" is grey or off: no key, no product data, or data that don't sound like a drink. -->
        <TextView
            android:id="@+id/dlg_jev_why"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Jev's answer: what it picks and, as a bar, how often such a pick was right. -->
        <LinearLayout
            android:id="@+id/dlg_jev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/dlg_jev_pick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp">

                <View
                    android:id="@+id/dlg_jev_meter"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="10dp" />

                <TextView
                    android:id="@+id/dlg_jev_trust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/dlg_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:text="@string/d8" />

        <Button
            android:id="@+id/dlg_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:text="@string/d15" />

        <Button
            android:id="@+id/dlg_25"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:text="@string/d25" />

        <Button
            android:id="@+id/dlg_crate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:text="@string/d_crate_fmt" />

        <Button
            android:id="@+id/dlg_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_bg"
            android:textColor="@color/text_dim"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:text="@string/d0" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:text="@string/off_credit" />
    </LinearLayout>
</ScrollView>
