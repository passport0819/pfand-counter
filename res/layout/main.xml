<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/camera_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:background="#FF000000">

        <TextureView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/aim_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:background="#66FF3B30" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="10dp"
            android:background="@drawable/pill"
            android:textColor="@color/on_camera"
            android:textSize="13sp"
            android:text="@string/aim_hint" />

        <Button
            android:id="@+id/torch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/pill"
            android:textColor="@color/on_camera"
            android:textSize="13sp"
            android:text="@string/torch" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/pill"
            android:src="@drawable/ic_b_settings"
            android:scaleType="center"
            android:contentDescription="@string/settings" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_label"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00€"
                android:textColor="@color/accent"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/breakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/items_none"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

            <Button
                android:id="@+id/sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minHeight="40dp"
                android:minWidth="64dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_bg"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone"
                android:text="@string/sort_newest" />

            <Button
                android:id="@+id/share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/btn_bg"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone"
                android:text="@string/share" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:divider="@color/surface_high"
        android:dividerHeight="1dp"
        android:background="@color/bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="@color/surface">

        <Button android:id="@+id/add8"  style="@style/PadButton" android:text="@string/btn_8" />
        <Button android:id="@+id/add15" style="@style/PadButton" android:text="@string/btn_15" />
        <Button android:id="@+id/add25" style="@style/PadButton" android:text="@string/btn_25" />
        <Button android:id="@+id/crate" style="@style/PadButton" android:text="@string/btn_crate" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="8dp"
        android:background="@color/surface">

        <Button
            android:id="@+id/guide"
            style="@style/PadButton"
            android:background="@drawable/btn_accent"
            android:text="@string/btn_guide" />

        <Button
            android:id="@+id/reset"
            style="@style/PadButton"
            android:background="@drawable/btn_bad"
            android:text="@string/btn_reset" />
    </LinearLayout>
</LinearLayout>
