<?xml version="1.0" encoding="utf-8"?>
<!-- Dark design. -->
<resources>
    <!-- Material 3: the app's text and accent are Android's own colour roles, taken from the
         wallpaper (Android 14 and later always has them). Red, warning, the camera labels and the icon stay fixed.
         Background and surfaces come from the theme (res/color, attrs.xml). -->
    <color name="accent">@android:color/system_primary_dark</color>
    <color name="on_accent">@android:color/system_on_primary_dark</color>
    <color name="accent_dim">@android:color/system_primary_container_dark</color>
    <color name="on_accent_dim">@android:color/system_on_primary_container_dark</color>
    <color name="text">@android:color/system_on_surface_dark</color>
    <color name="text_dim">@android:color/system_on_surface_variant_dark</color>
    <color name="warn">#FFE8B33C</color>
    <color name="bad">#FFE0645A</color>
    <color name="bad_dim">#FF9E3A33</color>
</resources>
